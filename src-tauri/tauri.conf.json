{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ctas",
  "version": "0.2.5",
  "identifier": "dev.nannndev.ctas",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "panel",
        "title": "Ctas",
        "url": "panel.html",
        "width": 460,
        "height": 780,
        "minWidth": 380,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "visible": false,
        "incognito": true
      },
      {
        "label": "main",
        "title": "Ctas",
        "width": 1280,
        "height": 800,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "shadow": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "incognito": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Entertainment",
    "shortDescription": "Pecut buat mecut AI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY4Rjk3NDE5REY0NkI4OTEKUldTUnVFYmZHWFQ1YUdsdlFHMk94b2k5a3UzaUJicGZPWUJkalZuK0tORjhSTjB3SE9XNUhlWi8K",
      "endpoints": [
        "https://github.com/nannndev/ctass/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
